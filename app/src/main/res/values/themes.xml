<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Base theme for Lunara. The UI itself is fully Compose/Material 3; this XML
      theme only paints the window black before Compose takes over (so there is
      no white flash on launch) and makes the system bars blend with the app.
    -->
    <style name="Theme.Lunara" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/lunara_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
